# Offline parser candidate. Building this file is not a hostile-media certification.
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.lock pyproject.toml /app/
RUN pip install --no-cache-dir -r requirements.lock
COPY analysis /app/analysis
COPY tools /app/tools
COPY contracts /app/contracts
COPY datasets/annotation-schema.json /app/datasets/annotation-schema.json
RUN useradd --uid 10001 --create-home parser
USER 10001:10001
ENV PYTHONDONTWRITEBYTECODE=1
ENTRYPOINT ["python", "-m", "tools.analyze_capture"]
