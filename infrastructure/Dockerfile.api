FROM python:3.12-slim@sha256:f77ac9e44ae96ef2c90b8053ea08c31f8be030f824196b0ae4db6d462c84e51f
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 DJANGO_DEBUG=0
WORKDIR /app
COPY requirements.lock requirements-cloud.lock ./
RUN python -m pip install --no-cache-dir -r requirements.lock -r requirements-cloud.lock
COPY backend backend
COPY analysis analysis
COPY ingestion ingestion
COPY contracts contracts
COPY datasets/annotation-schema.json datasets/annotation-schema.json
COPY manage.py ./
RUN useradd --uid 10001 --create-home api
USER 10001:10001
CMD ["python", "-m", "backend.config.serve"]
