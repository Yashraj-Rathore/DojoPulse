DJANGO_SECRET_KEY=replace-for-local-use
DJANGO_DEBUG=1
DATABASE_URL=postgresql://ptp:ptp_local_only@127.0.0.1:5432/ptp
ALLOW_SQLITE=0
PRIVATE_DATA_ROOT=./private_data
LOCAL_OPERATOR_UPLOADS=0
LOCAL_RECORDING_COMPANION=0
LOCAL_MATCH_IMPORTS=0
LOCAL_ACCOUNT_SIGNUP=0
# Local suppression defaults to DJANGO_SECRET_KEY; see docs/architecture/accounts-consent.md.
PARSER_BACKEND=docker
# docker image inspect dojopulse-parser:m15 --format '{{.Id}}'
PARSER_IMAGE=
# M16 control journal must have an independent, durable backup in hosting.
DEPLOYMENT_NAMESPACE=local
CONTROL_JOURNAL_ROOT=./private_data/control-journal
CONTROL_JOURNAL_KEY=replace-with-stable-separate-secret
PREVIEW_LEDGER_ROOT=./private_control/preview-writes
PREVIEW_LEDGER_KEY=replace-with-another-stable-separate-secret
RESTORE_QUARANTINE=0
# Cloud targets stay unset; CLOUD_MEDIA_RUNTIME_QUALIFIED cannot be toggled by env.
GCS_PRIVATE_BUCKET=
GOOGLE_TASK_QUEUE=
GOOGLE_ANALYSIS_JOB=
GOOGLE_TASK_TARGET=
GOOGLE_TASK_AUDIENCE=
GOOGLE_TASK_SERVICE_ACCOUNT=

# M06 local defaults. These selectors cannot bypass hard-coded qualification flags.
RESUMABLE_STORAGE_PROVIDER=LOCAL
PREVIEW_LEDGER_BACKEND=FILE
CONTROL_JOURNAL_BACKEND=FILE
PREVIEW_CLOUD_BACKEND=DISABLED
# M06.11 preparation only: see docs/architecture/hosted-recording-previews.md.
GOOGLE_PREVIEW_LEDGER_BUCKET=
GOOGLE_CONTROL_JOURNAL_BUCKET=
GOOGLE_EXECUTION_JOURNAL_BUCKET=
GOOGLE_BATCH_PARENT=
GOOGLE_BATCH_TEMPLATE=
GOOGLE_PREVIEW_COORDINATOR_IMAGE=
GOOGLE_PREVIEW_DECODER_IMAGE=
GOOGLE_PREVIEW_SERVICE_ACCOUNT=
# Exactly five nonsecret bucket/namespace values and five numeric secret-version
# references, respectively. Do not place secret VALUES in these JSON settings.
GOOGLE_PREVIEW_ENV_JSON={}
GOOGLE_PREVIEW_SECRETS_JSON={}
# Server-only Next configuration; omit for local loopback API. Never NEXT_PUBLIC.
DOJOPULSE_API_ORIGIN=http://127.0.0.1:8000
DOJOPULSE_API_IDENTITY=
DOJOPULSE_API_HOST=
# Trusted private-service routing only; Terraform prepares these, not public clients.
DJANGO_TRUST_GATEWAY_HOST=0
GOOGLE_TASK_GATEWAY_HOST=
